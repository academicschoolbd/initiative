# Smart Maheshkhali — Apache configuration
# ---------------------------------------------------------------
# This file is loaded only on Apache + AllowOverride All. Nginx
# users should consult the equivalent block in README.md.
# ---------------------------------------------------------------

# 1. Don't expose the directory contents if there's no index file.
Options -Indexes -MultiViews

# 2. Treat .php files as the default; the rewrite below also lets
#    us address them without the extension.
DirectoryIndex index.php index.html

# 3. Custom error pages.
ErrorDocument 404 /initiative/404.php

# ---------------------------------------------------------------
# 4. Block direct access to sensitive files.
# ---------------------------------------------------------------

# Local config (admin password hash, secrets).
<FilesMatch "^(config\.php|config\.example\.php)$">
    Require all denied
</FilesMatch>

# SQLite database files.
<FilesMatch "\.(sqlite|sqlite-journal|sqlite-shm|sqlite-wal)$">
    Require all denied
</FilesMatch>

# Dotfiles, .git/, .htaccess itself, and other meta files.
<FilesMatch "^\.(?!well-known)">
    Require all denied
</FilesMatch>

# Markdown / version-control / build artifacts.
<FilesMatch "\.(md|gitignore|gitattributes|env|lock|log)$">
    Require all denied
</FilesMatch>

# ---------------------------------------------------------------
# 5. Block the includes/ directory entirely.
# ---------------------------------------------------------------
RedirectMatch 404 ^/initiative/includes/.*$

# ---------------------------------------------------------------
# 6. Security headers (defence in depth — PHP also sends these).
# ---------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=()"

    # Strict-Transport-Security only makes sense over HTTPS — uncomment
    # once you have a valid certificate in place.
    #Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Don't leak the PHP / Apache version.
    Header unset X-Powered-By
    Header unset Server
</IfModule>
ServerSignature Off

# ---------------------------------------------------------------
# 7. Optional HTTPS redirect. Enable once your certificate is live.
# ---------------------------------------------------------------
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteCond %{HTTPS} !=on
#     RewriteCond %{HTTP:X-Forwarded-Proto} !=https
#     RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# ---------------------------------------------------------------
# 8. Clean URLs: /admin -> /admin.php, /index -> /index.php, etc.
#    NOTE: RewriteBase must match the URL the app is mounted at.
#    If you deploy at the domain root, change to `RewriteBase /`.
# ---------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /initiative/

    # Don't rewrite if the file or directory exists as-is.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Map extensionless requests to .php files.
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([^.]+)$ $1.php [L]
</IfModule>

# ---------------------------------------------------------------
# 9. Compression for textual responses.
# ---------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------------------------------------------------------------
# 10. Long cache for static assets (none today, but ready when added).
# ---------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png  "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
</IfModule>
